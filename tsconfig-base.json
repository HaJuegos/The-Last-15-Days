{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ES2020",
        "moduleResolution": "bundler",
        "noEmit": true,
        "paths": {
            "@minecraft/*": [ "./node_modules/@minecraft/*" ],
            "simplified-mojang-api/*": [ "./node_modules/simplified-mojang-api/*" ]
        },
        "lib": [
            "ES2020",
            "dom"
        ],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": false,
        "allowJs": true,
        "checkJs": true,
        "noImplicitAny": true,
        "sourceMap": false,
        "types": [
            "node"
        ]
    },
    "exclude": [
        "node_modules",
        "**/node_modules/*"
    ]
}