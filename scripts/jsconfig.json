{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "lib": [
            "ES2020"
        ],
        "types": [
            "node"
        ],
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "allowJs": true,
        "checkJs": true,
        "noImplicitAny": false,
        "useUnknownInCatchVariables": false,
        "noResolve": false,
        "traceResolution": false,
        "sourceMap": false
    },
    "include": [
        "./**/*.js"
    ],
    "exclude": [
        "../node_modules",
        "./**/node_modules/**"
    ]
}