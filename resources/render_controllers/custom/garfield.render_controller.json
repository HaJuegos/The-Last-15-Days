{
    "format_version": "1.10.0",
    "render_controllers": {
        "controller.render.garfield": {
            "arrays": {
                "textures": {
                    "Array.skins": [
                        "Texture.default",
                        "Texture.angry"
                    ]
                },
                "geometries": {
                    "Array.geo": [
                        "Geometry.default",
                        "Geometry.angry"
                    ]
                }
            },
            "materials": [
                {
                    "*": "Material.default"
                }
            ],
            "geometry": "Array.geo[q.skin_id]",
            "textures": [
                "Array.skins[q.skin_id]"
            ]
        }
    }
}