{
    "format_version": "1.10.0",
    "render_controllers": {
        "controller.render.entity_glowing": {
            "geometry": "Geometry.glowing",
            "materials": [
                { "*": "Material.glowing" }
            ],
            "textures": [
                "Texture.default"
            ],
            "ignore_lighting": true,
            "on_fire_color": {
                "r": "1.0",
                "g": "1.0",
                "b": "0.75",
                "a": "0.55 + 0.55 * Math.pow(1.0 - Math.mod(query.life_time, 3) / 3, 0.5)"
            },
            "is_hurt_color": {
                "r": "1.0",
                "g": "1.0",
                "b": "0.75",
                "a": "0.55 + 0.55 * Math.pow(1.0 - Math.mod(query.life_time, 3) / 3, 0.5)"
            },
            "overlay_color": {
                "r": "1.0",
                "g": "1.0",
                "b": "0.75",
                "a": "0.55 + 0.55 * Math.pow(1.0 - Math.mod(query.life_time, 3) / 3, 0.5)"
            }
        }
    }
}