{
    "format_version": "1.10.0",
    "minecraft:client_entity": {
        "description": {
            "identifier": "minecraft:vex",
            "min_engine_version": "1.8.0",
            "materials": {
                "default": "raid_base",
                "glowing": "raid_glow"
            },
            "textures": {
                "default": "textures/entity/vex/vex",
                "charging": "textures/entity/vex/vex_charging"
            },
            "geometry": {
                "default": "geometry.vex.v1.8",
                "glowing": "geometry.vex.v1.8.glow"
            },
            "scripts": {
                "pre_animation": [
                    "variable.tcos0 = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;",
                    "variable.empty_handed  = !query.is_item_equipped(0) && !query.is_item_equipped(1);"
                ],
                "scale": "1.0",
                "animate": [
                    "look_at_target_control",
                    "vex_charge_control",
                    "vex_idle_control",

                    "glowing_scale"
                ]
            },
            "animations": {
                "glowing_scale": "animation.entity_glow.glowing_scale",

                "look_at_target_control": "controller.animation.humanoid.look_at_target",
                "vex_charge_control": "controller.animation.vex.charge",
                "vex_idle_control": "controller.animation.vex.idle",

                "look_at_target_default": "animation.humanoid.look_at_target.default",
                "look_at_target_gliding": "animation.humanoid.look_at_target.gliding",
                "look_at_target_swimming": "animation.humanoid.look_at_target.swimming",
                "move": "animation.humanoid.move",
                "riding.arms": "animation.humanoid.riding.arms",
                "riding.legs": "animation.humanoid.riding.legs",
                "holding": "animation.humanoid.holding",
                "brandish_spear": "animation.humanoid.brandish_spear",
                "charging": "animation.humanoid.charging",
                "attack.rotations": "animation.humanoid.attack.rotations",
                "sneaking": "animation.humanoid.sneaking",
                "bob": "animation.humanoid.bob",
                "damage_nearby_mobs": "animation.humanoid.damage_nearby_mobs",
                "bow_and_arrow": "animation.humanoid.bow_and_arrow",
                "swimming": "animation.humanoid.swimming",
                "use_item_progress": "animation.humanoid.use_item_progress",
                "vex_move": "animation.vex.move",
                "vex_charge": "animation.vex.charge",
                "vex_idle": "animation.vex.idle"
            },
            "render_controllers": [
                {
                    "controller.render.entity_glowing": "q.property('ha:is_glow')"
                },
                "controller.render.vex"
            ],
            "spawn_egg": {
                "texture": "spawn_egg_vex"
            },
            "held_item_ignores_lighting": true
        }
    }
}