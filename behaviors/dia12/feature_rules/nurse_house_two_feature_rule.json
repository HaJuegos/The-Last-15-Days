{
    "format_version": "1.13.0",
    "minecraft:feature_rules": {
        "description": {
            "identifier": "ha:nurse_house_two_feature_rule",
            "places_feature": "ha:nurse_house_feature"
        },
        "conditions": {
            "placement_pass": "first_pass",
            "minecraft:biome_filter": {
                "test": "has_biome_tag",
                "operator": "==",
                "value": "the_end"
            }
        },
        "distribution": {
            "iterations": "(v.originx == 0 && v.originz == -80) ? 1 : 0",
            "scatter_chance": {
                "numerator": 1,
                "denominator": 2
            },
            "coordinate_eval_order": "xzy",
            "x": {
                "distribution": "uniform",
                "extent": [ 0, 7 ]
            },
            "z": {
                "distribution": "uniform",
                "extent": [ 0, 7 ]
            },
            "y": "query.heightmap(v.worldx, v.worldz)"
        }
    }
}